  "improveQuotes": [
    {
      "who": "Larry Jaramillo",
      "date": "06/18/2026",
      "text": "Utilize a cheater pipe from the beginning stages of the job instead of \u201cbouncing\u201d on the pipe wrench and risking a potential fall."
    },
    {
      "who": "Brianda Sandoval",
      "date": "07/08/2026",
      "text": "Set up a completely sealed exclusion zone \u2014 not just cones \u2014 because some people felt entitled to walk right in. I had to kick them out."
    },
    {
      "who": "Nathan Contreras",
      "date": "07/23/2026",
      "text": "Do a pre-task briefing beforehand to ensure everyone is on the same page on job progression."
    },
    {
      "who": "Ralph Forbes",
      "date": "07/14/2026",
      "text": "Language barrier is a concern \u2014 roustabouts speak and understand Spanish, not so good with English."
    },
    {
      "who": "Jacob Hernandez",
      "date": "07/25/2026",
      "text": "Interpret the Spanish side of the 12 Life-Saving Rules."
    },
    {
      "who": "Stefanie Kirschke",
      "date": "06/18/2026",
      "text": "Add a brief refresher on offset frac protection criteria for new crew members before the job."
    },
    {
      "who": "Brianda Sandoval",
      "date": "06/20/2026",
      "text": "A crew member showed up with an invalid fit-test card \u2014 we used someone else to break containment and flagged the card."
    },
    {
      "who": "Jordan Lemmons",
      "date": "06/15/2026",
      "text": "Always check before starting work to make sure no casing valves are leaking \u2014 check the bleeders."
    },
    {
      "who": "Ralph Forbes",
      "date": "07/15/2026",
      "text": "Verify all equipment is actually going to show up \u2014 the vac truck didn\u2019t, and it made a big mess cleaning tanks out."
    },
    {
      "who": "Jeremy Norris",
      "date": "07/15/2026",
      "text": "More atmospheric tests while the crew is working, while staying out of the line of fire."
    }
